          "range": true
        },
        {
          "refId": "B",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"raspberry-pi\"} / node_memory_MemTotal_bytes{job=\"raspberry-pi\"})",
          "legendFormat": "RAM",
          "range": true
