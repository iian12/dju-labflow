# Use as backend/.env on the production host. Supply actual credentials privately.
APP_PROFILE=prod
DB_URL=jdbc:mariadb://db:3306/labflow
DB_USERNAME=labflow
DB_PASSWORD=
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
CORS_ALLOWED_ORIGINS=https://app.example.com
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAME_SITE=Lax
# Documentation only: production fixes this to validate regardless of this custom variable.
JPA_DDL_AUTO=validate
API_DOCS_ENABLED=false
EMAIL_VERIFICATION_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Replace with actual ingress proxy CIDRs; never trust all networks.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
LOGIN_IP_LIMIT=60
LOGIN_ACCOUNT_IP_LIMIT=10
