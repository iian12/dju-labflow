# Copy to backend/.env and fill in your local values.
# Plain KEY=value syntax: no export, surrounding quotes, or inline comments.
APP_PROFILE=local
DB_URL=jdbc:mariadb://localhost:3306/labflow
DB_USERNAME=labflow
DB_PASSWORD=
# Set a private random value with at least 32 UTF-8 bytes.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
# Use migrations/DDL to prepare the schema before running with validate.
JPA_DDL_AUTO=validate
API_DOCS_ENABLED=true
