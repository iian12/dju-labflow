# Copy to backend/.env and fill in your local values.
# Plain KEY=value syntax: no export, surrounding quotes, or inline comments.
APP_PROFILE=local
DB_URL=jdbc:mariadb://localhost:3306/labflow
DB_USERNAME=labflow
DB_PASSWORD=
# Set a private random value with at least 32 UTF-8 bytes.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax
# Flyway creates empty schemas. Existing DBs need the explicit adoption steps in database/README.md.
# Override only for isolated local experiments; production always uses validate.
JPA_DDL_AUTO=validate
API_DOCS_ENABLED=true

# Independent random secret (at least 32 UTF-8 bytes); do not reuse JWT_SECRET_KEY.
EMAIL_VERIFICATION_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# SDK default heartbeat interval: 30s. Durations accept s/m/h suffixes.
RUN_HEARTBEAT_TIMEOUT=2m

# Trust forwarding headers only from these immediate proxy networks. Empty = no proxies.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Fixed-window login budgets: per IP/minute and per normalized email+IP/15 minutes.
LOGIN_IP_LIMIT=60
LOGIN_ACCOUNT_IP_LIMIT=10
